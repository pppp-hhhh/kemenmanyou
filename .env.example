# ============================================
# 课文漫游 · 统一环境配置模板
# 复制为根目录 .env 后按需填写
# Nuxt：pnpm dev（内置 --dotenv ../.env）
# Python：server/config.py 自动加载
# ============================================

# ---------- Nuxt 端 ----------
PYTHON_BACKEND_URL=http://127.0.0.1:8001
INVITE_CODE_SECRET=your-random-secret    # >=16 字符
AUTH_SECRET=your-random-secret           # 登录令牌签名密钥

# ---------- 文本分析供应商 ----------
# 可选：deepseek(默认) / sensenova / openai / openrouter / custom
ANALYZE_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 文本分析单次 LLM 调用总超时（秒）。分镜 JSON 生成走推理模型，可能超过 180s；
# 默认 300，网关慢可上调（>=300）。
ANALYZE_TIMEOUT=300

# ---------- SenseNova（生图 + 可选文本分析） ----------
SENSE_NOVA_API_KEY=your-sensenova-api-key
SENSE_NOVA_BASE_URL=https://token.sensenova.cn/v1
SENSE_NOVA_IMAGE_MODEL=sensenova-u1-fast
SENSE_NOVA_IMAGE_SIZE=2048x2048
SENSE_NOVA_WATERMARK=false               # false=无水印（公测免费，后续转付费）
SENSE_NOVA_CHAT_MODEL=deepseek-v4-flash  # ANALYZE_PROVIDER=sensenova 时的文本分析模型

# ---------- 静态文件（一般无需修改） ----------
STATIC_DIR=../static
TEMP_DIR=../static/temp
WORKS_DIR=../static/works

# ---------- Supabase（运行时已弃用，回迁云端时启用；schema 见 init_supabase.sql） ----------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key
